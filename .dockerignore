# Keep Git metadata and local credentials out of the Fly.io container.
.git/
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Keep private Git metadata, state snapshots and credentials out of images.
.private_runtime/.git/
.private_runtime/**/.git/
.private_runtime/**/.env
.private_runtime/**/.env.*
.private_runtime/**/__pycache__/
.private_runtime/**/.pytest_cache/
.private_runtime/ASCENSION_CORE/state/
.private_runtime/ASCENSION_CORE/state_demo/
.private_runtime/clarity/**/__pycache__/
*.pyc
