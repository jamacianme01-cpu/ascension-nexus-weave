# ASCENSION native persisted data — owner-controlled secrets configured outside source; retired Fly endpoints are prohibited.
# Existing PostgreSQL database with ASCENSION tables and guest RPCs. Do NOT initialize a blank database.
DATABASE_URL=
# Durable owner-approved mounted directory for ASCENSION object files.
ASCENSION_STORAGE_DIR=
# Existing ASCENSION execution queue authentication (configure through the owner-approved runtime).
ASCENSION_PUBLISH_TOKEN=
# Optional explicitly authorized external model contribution; disabled by default.
ASCENSION_ENABLE_PAID_APIS=false
ASCENSION_ALLOW_OPENAI_AI=false
