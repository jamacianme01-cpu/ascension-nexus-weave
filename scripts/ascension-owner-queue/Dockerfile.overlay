# Extend the existing PRIVATE Fly image containing the owner's authored engines.
# Original ASCENSION_CORE and CLARITY source NEVER enters public GitHub.
ARG ORIGINAL_OWNER_IMAGE
FROM ${ORIGINAL_OWNER_IMAGE}
# The original private engine image is Python-based. The V1 site requires Bun.
# Bundle the already-used Bun runtime rather than relying on a missing binary.
COPY --from=oven/bun:1.4.5 /usr/local/bin/bun /usr/local/bin/bun
# Original private Python image was missing public CA roots: the authored queue
# worker rejected Fly TLS with CERTIFICATE_VERIFY_FAILED and never claimed jobs.
# Restore ordinary certificate validation without disabling TLS checks.
COPY --from=oven/bun:1.4.5 /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
COPY .output/ /app/.output/
COPY ascension-volume-transport.py /app/ascension-volume-transport.py
COPY ascension_crystal_ledger.py /app/ascension_crystal_ledger.py
COPY ascension-private-supervisor.py /app/ascension-private-supervisor.py
COPY probe-ascension-private.py /app/probe-ascension-private.py
COPY ascension-start.sh /app/ascension-start.sh
COPY original-physical-capability.patch /app/original-physical-capability.patch
COPY apply-original-physical-capability.py /app/apply-original-physical-capability.py
# Apply exclusively to the ORIGINAL private engine image, never a public replacement.
# Abort build on any source mismatch; no Fly volume or governed state is written.
RUN /usr/bin/python3 /app/apply-original-physical-capability.py /app
RUN test -f /app/ASCENSION_CORE/cloud_queue_worker.py \
    && test -f /app/ASCENSION_CORE/live_publication.py \
    && test -f /app/clarity/core_runtime.py \
    && test -f /app/.output/server/index.mjs \
    && test -x /usr/local/bin/bun \
    && test -s /etc/ssl/certs/ca-certificates.crt \
    && /usr/bin/python3 -m py_compile /app/ascension-volume-transport.py /app/ascension_crystal_ledger.py /app/ascension-private-supervisor.py \
    && chmod 0755 /app/ascension-start.sh
ENV PYTHONPATH=/app
ENTRYPOINT ["/app/ascension-start.sh"]
CMD ["app"]
