+class PhysicalDesignCapability:
+    """Adapter for the existing UniversalConstructionEngine.
+
+    Does not invent a new engine. Registers the authored construction engine
+    under a formal capability contract so select_capability can return it for
+    physical_design contracts instead of unavailable:physical_design.
+    """
+
+    contract = CapabilityContract(
+        capability_id="physical_design",
+        name="Universal Construction (Physical Design)",
+        description=(
+            "Routes physical/hardware design objectives through the original "
+            "UniversalConstructionEngine Hunyuan3D generation adapter. Only an "
+            "integrity-validated model candidate is a deliverable; unmeasured "
+            "designs never claim dimensional or manufacturing verification."
+        ),
+        accepted_intent_tokens=[
+            "build", "create", "construct", "design", "make", "produce",
+            "drone", "drones", "robot", "robots", "machine", "machines",
+            "device", "hardware", "prototype", "vehicle", "motor", "engine",
+        ],
+        output_contract="physical_design",
+        constraints=[
+            "owner-approved local reference image required",
+            "no simulated crystal or triangle placeholder output",
+            "GLB source hashes and validation evidence required",
+        ],
+        required_authority="CLARITY:orchestrator",
+        evidence_produced="actual Hunyuan GLB digest and matched original metadata receipt",
+        verification_method="glTF v2 header, byte length and SHA256 against original metadata",
+        risk_class="medium",
+        available=True,
+    )
+
+    def write(self, branch: Branch, mes: List[MeaningElement]) -> CapabilityResult:
+        """Call the actual original Hunyuan3D executor; never the placeholder
+        physical_design branch of UniversalConstructionEngine.
+
+        The latter writes a three-vertex OBJ and text files named .stl/.3mf,
+        then labels them verified. None of those files is a physical design.
+        """
+        import hashlib
+        import os
+        from pathlib import Path as _Path
+
+        root = _Path(os.environ.get("ASCENSION_REPOSITORY_ROOT") or
+                     os.environ.get("ASCENSION_WORKSPACE_ROOT") or ".").resolve()
+        reference_value = os.environ.get("ASCENSION_PHYSICAL_REFERENCE_IMAGE", "").strip()
+        if not reference_value:
+            raise RuntimeError(
+                "REAL_PHYSICAL_GENERATION_BLOCKED: owner-approved reference image is required; "
+                "no simulated crystal, triangle OBJ or fabricated dimensions will be returned."
+            )
+        reference = _Path(reference_value).expanduser().resolve()
+        if not reference.is_file() or reference.suffix.lower() not in (".png", ".jpg", ".jpeg", ".webp"):
+            raise RuntimeError(
+                "REAL_PHYSICAL_GENERATION_BLOCKED: approved reference image is unavailable."
+            )
+        objective = str(getattr(branch, "approach", "") or "").strip()
+        meaning = [str(m.text).strip() for m in mes if str(m.text).strip()]
+        if not objective or not meaning:
+            raise RuntimeError("REAL_PHYSICAL_GENERATION_BLOCKED: objective and Meaning Elements are required.")
+
+        from clarity.autosync.construction_engine import UniversalConstructionEngine
+        engine = UniversalConstructionEngine(repository_root=root)
+        job = engine.create_job(
+            objective=objective,
+            meaning_elements=meaning,
+            artifact_type="generative_3d_form",
+            source_materials=[str(reference)],
+            constraints={
+                "reference_image": str(reference),
+                "scale_intent": "object",
+                "target_domain": "physical_design",
+                "downstream_destination": "ASCENSION_UNREAL",
+            },
+        )
+        job = engine.run_job(job)
+        if job.build_state != "candidate_validated" or len(job.final_artifact_paths) < 2:
+            raise RuntimeError(
+                "REAL_PHYSICAL_GENERATION_BLOCKED: original 3D executor returned " +
+                str(job.build_state) + "; no geometry was accepted."
+            )
+
+        model = _Path(job.final_artifact_paths[0]).resolve()
+        metadata_file = _Path(job.final_artifact_paths[1]).resolve()
+        if not model.is_file() or model.suffix.lower() != ".glb" or not metadata_file.is_file():
+            raise RuntimeError("REAL_PHYSICAL_GENERATION_BLOCKED: original GLB/metadata files are missing.")
+        raw = model.read_bytes()
+        if len(raw) < 20 or raw[:4] != b"glTF" or int.from_bytes(raw[4:8], "little") != 2 or int.from_bytes(raw[8:12], "little") != len(raw):
+            raise RuntimeError("REAL_PHYSICAL_GENERATION_BLOCKED: original Hunyuan GLB failed container validation.")
+        metadata = json.loads(metadata_file.read_text(encoding="utf-8"))
+        digest = hashlib.sha256(raw).hexdigest()
+        if (metadata.get("status") != "validated_candidate" or
+                metadata.get("mesh_sha256") != digest or
+                metadata.get("dimensionally_authoritative") is not False or
+                metadata.get("source_prompt") != objective):
+            raise RuntimeError("REAL_PHYSICAL_GENERATION_BLOCKED: generated model provenance is not valid.")
+
+        receipt = {
+            "capability": self.contract.capability_id,
+            "objective": objective,
+            "meaning_elements": meaning,
+            "generation_status": "validated_candidate",
+            "model_format": "glb",
+            "model_path": str(model),
+            "model_sha256": digest,
+            "metadata_path": str(metadata_file),
+            "reference_image_sha256": metadata["reference_sha256"],
+            "dimensionally_authoritative": False,
+            "physical_manufacture_verified": False,
+        }
+        description = (
+            "# Original 3D Candidate\n\n" + objective + "\n\n" +
+            "Generated by the original UniversalConstructionEngine/Hunyuan3D adapter.\n" +
+            "The GLB passed file-integrity tests; physical dimensions, performance, " +
+            "safety and manufacture are NOT verified.\n"
+        )
+        return CapabilityResult(
+            capability=self.contract.capability_id,
+            files={
+                "physical_design.md": description,
+                "physical_design_receipt.json": json.dumps(receipt, sort_keys=True, indent=2),
+            },
+            primary_artifact="physical_design.md",
+        )
+
+
+
+
 REGISTRY: Dict[str, object] = {
     DigitalArtifactWriter.contract.capability_id: DigitalArtifactWriter(),
     DocumentBundleCapability.contract.capability_id: DocumentBundleCapability(),
+    PhysicalDesignCapability.contract.capability_id: PhysicalDesignCapability(),
 }
 
 
